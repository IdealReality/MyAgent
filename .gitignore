# --- Personal / AI-agent workspace (not for the public fork) ---
.claude/
/docs/superpowers/
**/CLAUDE.md
**/AGENTS.md

# Sibling clones of upstream projects used as references during development
/termux-api/

# Sensitive build inputs (signed-in service account / Firebase config)
app/google-services.json
# Release artifacts staged for GitHub release uploads — debug-signed APKs are
# regenerated each release; no need to track them in git.
/release-artifacts/

# Release signing keystore — never commit
/rikkahub-release.jks

# Local planning doc — not for the remote
/enhance.md

# Separate companion repo - cloned locally, not part of this repo
/agent-keyboard/

# Generated baseline profiles (baseline profiling dropped in this fork)
/app/src/release/generated/

# bun.lock is generated from the tracked pnpm-lock.yaml on clean checkouts
/web-ui/bun.lock

# local build output
dist/

# --- 2026-11-07: worktree hygiene (backups and build logs are not source) ---
# Manual .bak copies made before edits; the change itself lives in the tracked file,
# so these stay on disk purely as a rollback point and must not enter history.
*.bak-*
*.bak2-*
*.bak-close
# Build / installer logs from local iteration
*.log
# Signing intermediates and staged APKs
*.idsig
/*.apk
/*.idsig

# One-off debugging / commit helpers from earlier sessions. Kept on disk for reference;
# they are not part of the build and should not enter history.
/_*
/diag-*.ps1
/do-commit*.ps1
/fix-commit6.ps1
/fix-ar*.ps1
/fix-de.ps1
/fix-locales.ps1
/fix-path.ps1
/append-strings*.ps1
/dedup-strings.ps1
/check-ar.ps1
/get-rep.ps1
/probe-supports.ps1
/waiter.ps1
/buildk.ps1
/build-align1*
/push-align1.cmd
/envprobe.txt
/test-report.txt

# Throwaway string-extraction dumps
/strings-p6.json
/strings-payload.json
/.buildlog-path
/build-*.err
/build-run.out
